{
  "name": "@gittree/core",
  "version": "1.0.0",
  "description": "Pure TypeScript: repo snapshot contract, topology inference, layout, points of interest.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
